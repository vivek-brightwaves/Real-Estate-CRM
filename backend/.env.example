# Database Configuration
DATABASE_URL=mysql+pymysql://crm_user:YOUR_MYSQL_PASSWORD@localhost:3307/crm_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# Security
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
TRUSTED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Project Settings
PROJECT_NAME="Real Estate CRM"
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
DEFAULT_BROKER_COMMISSION_PERCENT=2.0

# Background Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_MAX_WORKERS=10
SCHEDULER_JOB_MAX_RETRIES=3
SCHEDULER_RETRY_DELAY_SECONDS=60
SCHEDULER_MISFIRE_GRACE_SECONDS=300
SCHEDULER_LOCK_TIMEOUT_MINUTES=60
SCHEDULER_DEDUPLICATION_SECONDS=45

# Retention and escalation
APPROVAL_ESCALATION_HOURS=24
TOKEN_RETENTION_DAYS=7
LOG_RETENTION_DAYS=365
NOTIFICATION_ARCHIVE_DAYS=90
NOTIFICATION_RETRY_BATCH_SIZE=100
NOTIFICATION_MAX_RETRIES=5
