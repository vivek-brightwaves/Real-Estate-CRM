MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=crm_db
MYSQL_USER=crm_user
MYSQL_PASSWORD=replace-with-a-strong-application-password
DATABASE_URL=mysql+pymysql://crm_user:URL_ENCODED_PASSWORD@mysql:3306/crm_db
MYSQL_HOST_PORT=3307

SECRET_KEY=replace-with-at-least-32-random-bytes
BACKEND_CORS_ORIGINS=https://crm.example.com
TRUSTED_HOSTS=crm.example.com,api.crm.example.com,localhost,127.0.0.1
NEXT_PUBLIC_API_URL=https://api.crm.example.com
NEXT_PUBLIC_ENABLE_DEMO_DATA=false

ACCESS_TOKEN_EXPIRE_MINUTES=60
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
LOG_LEVEL=INFO
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
SEED_DEMO_DATA=false
